{
	"name": "sveltekit-short-urls",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"start": "node ./build/index.js",
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && pnpm run check:guardrails && vp check && svelte-check --tsconfig ./tsconfig.json --tsgo --fail-on-warnings",
		"check:guardrails": "node tools/checks/run.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"test:unit": "vp test",
		"test:client": "vp test --project=client",
		"test:server": "vp test --project=server",
		"test:ci": "pnpm run test:guardrails && vp test --run",
		"test:guardrails": "node --test tools/checks/*.test.ts",
		"test": "pnpm run test:ci && pnpm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@fontsource-variable/overpass": "^5.3.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "5.0.5",
		"fathom-client": "^3.7.2",
		"playwright": "1.64.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"valibot": "^1.5.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"engines": {
		"node": ">=24.15.0",
		"pnpm": ">=12.0.0"
	},
	"packageManager": "pnpm@12.16.1"
}
